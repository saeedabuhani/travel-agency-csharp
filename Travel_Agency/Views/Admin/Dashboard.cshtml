@using Travel_Agency.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    var totalPackages = ViewBag.TotalPackages ?? 0;
    var totalBookings = ViewBag.TotalBookings ?? 0;
    var totalRevenue = ViewBag.TotalRevenue ?? 0m;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalReviews = ViewBag.TotalReviews ?? 0;
    var packagesWithWaitingList = ViewBag.PackagesWithWaitingList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       👑 ADMIN HERO HEADER
       ============================================ */
    .admin-hero {
        position: relative;
        min-height: 350px;
        background: url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .admin-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(88, 28, 135, 0.85) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .admin-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .admin-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .admin-title span {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .admin-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.8);
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    /* ============================================
       📊 MAIN CONTENT AREA
       ============================================ */
    .admin-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 350px);
    }

    .admin-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ============================================
       📈 STATS GRID
       ============================================ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
        margin-bottom: 60px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 35px 30px;
        text-align: center;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--stat-color);
    }

    .stat-card:hover {
        transform: translateY(-10px);
        border-color: var(--stat-color);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3), 0 0 30px var(--stat-glow);
    }

    .stat-card-packages { --stat-color: #06b6d4; --stat-glow: rgba(6, 182, 212, 0.3); }
    .stat-card-bookings { --stat-color: #8b5cf6; --stat-glow: rgba(139, 92, 246, 0.3); }
    .stat-card-revenue { --stat-color: #f59e0b; --stat-glow: rgba(245, 158, 11, 0.3); }
    .stat-card-users { --stat-color: #ec4899; --stat-glow: rgba(236, 72, 153, 0.3); }

    .stat-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .stat-number {
        font-family: 'Playfair Display', serif;
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--stat-color);
        margin-bottom: 8px;
    }

    .stat-label {
        font-family: 'Poppins', sans-serif;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.7);
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    /* ============================================
       ⚡ QUICK ACTIONS
       ============================================ */
    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 40px;
        text-align: center;
    }

    .section-title span {
        color: #f59e0b;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
    }

    .action-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 20px;
        padding: 35px;
        text-align: center;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .action-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('https://images.unsplash.com/photo-1488085061387-422e29b40080?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80') center/cover no-repeat;
        opacity: 0.03;
        z-index: 0;
    }

    .action-card > * {
        position: relative;
        z-index: 1;
    }

    .action-card:hover {
        transform: translateY(-8px);
        border-color: rgba(245, 158, 11, 0.5);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .action-icon {
        font-size: 3.5rem;
        margin-bottom: 20px;
    }

    .action-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 12px;
    }

    .action-description {
        font-family: 'Poppins', sans-serif;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        margin-bottom: 25px;
        line-height: 1.6;
    }

    .btn-action {
        padding: 14px 35px;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action:hover {
        transform: translateY(-3px);
        color: #fff;
    }

    .btn-create {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: #fff;
        box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
    }

    .btn-manage {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: #fff;
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
    }

    .btn-bookings {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
    }

    .btn-users {
        background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
        color: #fff;
        box-shadow: 0 8px 25px rgba(236, 72, 153, 0.4);
    }

    .btn-reports {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .admin-title {
            font-size: 2.5rem;
        }

        .admin-hero {
            min-height: 280px;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }

        .stat-number {
            font-size: 2.2rem;
        }
    }

    @@media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- 👑 ADMIN HERO HEADER -->
<div class="admin-hero">
    <div class="admin-hero-content">
        <h1 class="admin-title">👑 Admin <span>Dashboard</span></h1>
        <p class="admin-subtitle">Control Center</p>
    </div>
</div>

<!-- 📊 MAIN CONTENT -->
<div class="admin-content">
    <div class="admin-container">

        <!-- 📈 STATISTICS -->
        <div class="stats-grid">
            <div class="stat-card stat-card-packages">
                <div class="stat-icon">📦</div>
                <div class="stat-number">@totalPackages</div>
                <div class="stat-label">Travel Packages</div>
            </div>

            <div class="stat-card stat-card-bookings">
                <div class="stat-icon">🎫</div>
                <div class="stat-number">@totalBookings</div>
                <div class="stat-label">Total Bookings</div>
            </div>

            <div class="stat-card stat-card-revenue">
                <div class="stat-icon">💰</div>
                <div class="stat-number">$@totalRevenue.ToString("N0")</div>
                <div class="stat-label">Total Revenue</div>
            </div>

            <div class="stat-card stat-card-users">
                <div class="stat-icon">👥</div>
                <div class="stat-number">@totalUsers</div>
                <div class="stat-label">Registered Users</div>
            </div>
        </div>

        <!-- ⚡ QUICK ACTIONS -->
        <h2 class="section-title">⚡ Quick <span>Actions</span></h2>

        <div class="actions-grid">
            <div class="action-card">
                <div class="action-icon">✨</div>
                <h3 class="action-title">Create Package</h3>
                <p class="action-description">
                    Add new travel destinations and packages to the catalog
                </p>
                <a asp-controller="TravelPackages" asp-action="Create" class="btn-action btn-create">
                    🚀 Create New
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">📋</div>
                <h3 class="action-title">Manage Packages</h3>
                <p class="action-description">
                    View, edit, and manage all existing travel packages
                </p>
                <a asp-controller="TravelPackages" asp-action="Index" class="btn-action btn-manage">
                    ⚙️ Manage
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">🎟️</div>
                <h3 class="action-title">All Bookings</h3>
                <p class="action-description">
                    Monitor and manage all customer bookings
                </p>
                <a asp-controller="Bookings" asp-action="AllBookings" class="btn-action btn-bookings">
                    📊 View All
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">👤</div>
                <h3 class="action-title">User Management</h3>
                <p class="action-description">
                    Manage users, roles, and permissions
                </p>
                <a asp-controller="Admin" asp-action="Users" class="btn-action btn-users">
                    👥 Manage Users
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">📈</div>
                <h3 class="action-title">Analytics</h3>
                <p class="action-description">
                    View detailed statistics and business insights
                </p>
                <a asp-controller="Admin" asp-action="Analytics" class="btn-action btn-reports">
                    📉 View Data
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">📄</div>
                <h3 class="action-title">Export Reports</h3>
                <p class="action-description">
                    Generate and download PDF/Excel reports
                </p>
                <a asp-controller="Admin" asp-action="ExportPdf" class="btn-action btn-manage">
                    📥 Export PDF
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">⏳</div>
                <h3 class="action-title">Waiting List</h3>
                <p class="action-description">
                    Manage users waiting for packages with no available rooms
                </p>
                <a asp-controller="Admin" asp-action="WaitingList" class="btn-action btn-bookings">
                    📋 Manage List
                </a>
            </div>

            <div class="action-card">
                <div class="action-icon">⭐</div>
                <h3 class="action-title">Reviews & Ratings</h3>
                <p class="action-description">
                    View all user reviews and assessments for travel packages
                </p>
                <a asp-controller="Admin" asp-action="Reviews" class="btn-action btn-reports">
                    📝 View Reviews (@totalReviews)
                </a>
            </div>

        </div>

        @* 📦 PACKAGES WITH 0 ROOMS AND WAITING LISTS *@
        @if (packagesWithWaitingList.Any())
        {
            <h2 class="section-title" style="margin-top: 60px;">📦 Packages with <span>Waiting Lists</span></h2>
            <div class="actions-grid" style="margin-top: 30px;">
                @foreach (dynamic item in packagesWithWaitingList)
                {
                    var package = item.Package as TravelPackage;
                    var waitingCount = (int)item.WaitingCount;
                    if (package != null)
                    {
                        <div class="action-card" style="text-align: left; padding: 25px;">
                            <div style="display: flex; align-items: center; gap: 20px;">
                                @if (!string.IsNullOrEmpty(package.ImageUrl))
                                {
                                    <img src="@package.ImageUrl" alt="@package.Destination" style="width: 120px; height: 80px; object-fit: cover; border-radius: 10px;">
                                }
                                <div style="flex: 1;">
                                    <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.2rem;">@package.Destination, @package.Country</h3>
                                    <p style="color: rgba(255,255,255,0.6); margin: 5px 0;">Available Rooms: <strong style="color: #ef4444;">0</strong></p>
                                    <p style="color: rgba(255,255,255,0.6); margin: 5px 0;">⏳ Waiting Users: <strong style="color: #f59e0b;">@waitingCount</strong></p>
                                </div>
                            </div>
                            <a asp-controller="Admin" asp-action="WaitingList" asp-route-packageId="@package.Id" class="btn-action btn-bookings" style="margin-top: 15px; display: inline-block;">
                                👁️ View Waiting List
                            </a>
                        </div>
                    }
                }
            </div>
        }

    </div>
</div>
