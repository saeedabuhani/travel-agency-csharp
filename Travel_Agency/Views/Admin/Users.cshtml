@model List<Travel_Agency.Controllers.UserWithRoleViewModel>

@{
    ViewData["Title"] = "User Management";
    var currentUserEmail = User.Identity!.Name;
    var isMasterAdmin = currentUserEmail == "admin@gmail.com";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       👥 USERS HERO HEADER
       ============================================ */
    .users-hero {
        position: relative;
        min-height: 300px;
        background: url('https://images.unsplash.com/photo-1521295121783-8a321d551ad2?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .users-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.85) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .users-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .users-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .users-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.8);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 MAIN CONTENT
       ============================================ */
    .users-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 300px);
    }

    .users-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ============================================
       🔔 ALERTS
       ============================================ */
    .alert-custom {
        padding: 18px 25px;
        border-radius: 15px;
        margin-bottom: 30px;
        font-family: 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-success-custom {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
    }

    .alert-error-custom {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }

    /* ============================================
       🔒 ACCESS RESTRICTED
       ============================================ */
    .no-access-box {
        text-align: center;
        padding: 50px 30px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 20px;
        margin-bottom: 40px;
    }

    .no-access-box h3 {
        font-family: 'Poppins', sans-serif;
        color: #fca5a5;
        font-size: 1.5rem;
        margin-bottom: 10px;
    }

    .no-access-box p {
        color: rgba(255, 255, 255, 0.6);
        font-family: 'Poppins', sans-serif;
    }

    /* ============================================
       📊 USERS TABLE
       ============================================ */
    .users-table-container {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 30px;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .users-table thead th {
        font-family: 'Poppins', sans-serif;
        background: rgba(139, 92, 246, 0.15);
        color: #a78bfa;
        padding: 18px 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
    }

    .users-table thead th:first-child {
        border-radius: 12px 0 0 12px;
    }

    .users-table thead th:last-child {
        border-radius: 0 12px 12px 0;
    }

    .users-table tbody tr {
        background: rgba(255, 255, 255, 0.02);
        transition: all 0.3s ease;
    }

    .users-table tbody tr:hover {
        background: rgba(139, 92, 246, 0.1);
        transform: translateX(5px);
    }

    .users-table tbody tr.blocked-row {
        background: rgba(239, 68, 68, 0.1);
        border-left: 4px solid #ef4444;
    }

    .users-table tbody td {
        font-family: 'Poppins', sans-serif;
        padding: 20px;
        border: none;
        color: rgba(255, 255, 255, 0.9);
        vertical-align: middle;
    }

    .users-table tbody td:first-child {
        border-radius: 12px 0 0 12px;
    }

    .users-table tbody td:last-child {
        border-radius: 0 12px 12px 0;
    }

    .age-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 16px;
        font-size: 0.8rem;
        font-weight: 600;
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .user-name {
        font-weight: 600;
        color: #fff;
    }

    .user-email {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .master-crown {
        font-size: 1.3rem;
        animation: crownBounce 2s ease-in-out infinite;
    }

    @@keyframes crownBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }

    /* ============================================
       🏷️ ROLE & STATUS BADGES
       ============================================ */
    .role-badge {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .badge-master {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #000;
        box-shadow: 0 5px 15px rgba(251, 191, 36, 0.4);
    }

    .badge-admin {
        background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
        color: #fff;
        box-shadow: 0 5px 15px rgba(236, 72, 153, 0.4);
    }

    .badge-user {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .badge-protected {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #000;
        font-size: 0.75rem;
    }

    .badge-blocked {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
        box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
        animation: pulse-red 2s infinite;
    }

    @@keyframes pulse-red {
        0%, 100% { box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4); }
        50% { box-shadow: 0 5px 25px rgba(239, 68, 68, 0.7); }
    }

    .badge-active {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .blocked-info {
        font-size: 0.75rem;
        color: #fca5a5;
        margin-top: 5px;
    }

    /* ============================================
       🔘 ACTION BUTTONS
       ============================================ */
    .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 10px 18px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-promote {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
    }

    .btn-promote:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
    }

    .btn-demote {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
    }

    .btn-demote:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4);
    }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.4);
    }

    .btn-block {
        background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        color: #fff;
    }

    .btn-block:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(107, 114, 128, 0.4);
    }

    .btn-unblock {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: #fff;
    }

    .btn-unblock:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.4);
    }

    .btn-disabled {
        background: rgba(107, 114, 128, 0.3);
        color: rgba(255, 255, 255, 0.4);
        cursor: not-allowed;
    }

    /* ============================================
       📊 STATS SUMMARY
       ============================================ */
    .stats-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 15px;
        padding: 25px;
        text-align: center;
    }

    .stat-card .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .stat-card .stat-value {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-card .stat-label {
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-card.blocked-stat {
        border-color: rgba(239, 68, 68, 0.3);
    }

    .stat-card.blocked-stat .stat-value {
        color: #fca5a5;
    }

    /* ============================================
       🔙 BACK BUTTON
       ============================================ */
    .back-section {
        text-align: center;
        margin-top: 50px;
    }

    .btn-back {
        padding: 15px 40px;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 25px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
    }

    .btn-back:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(139, 92, 246, 0.5);
        color: #fff;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .users-title {
            font-size: 2.2rem;
        }

        .users-table-container {
            padding: 15px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-action {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- 👥 USERS HERO HEADER -->
<div class="users-hero">
    <div class="users-hero-content">
        <h1 class="users-title">👥 User Management</h1>
        <p class="users-subtitle">Manage Roles, Permissions & Security</p>
    </div>
</div>

<!-- 📋 MAIN CONTENT -->
<div class="users-content">
    <div class="users-container">

        @if (TempData["Success"] != null)
        {
            <div class="alert-custom alert-success-custom">
                ✅ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-custom alert-error-custom">
                ❌ @TempData["Error"]
            </div>
        }

        @if (!isMasterAdmin)
        {
            <div class="no-access-box">
                <h3>🔒 Access Restricted</h3>
                <p>Only the master admin (admin@gmail.com) can manage users and roles.</p>
            </div>
        }

        <!-- 📊 STATS SUMMARY -->
        <div class="stats-summary">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-value">@Model.Count</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">⚡</div>
                <div class="stat-value">@Model.Count(u => u.IsAdmin)</div>
                <div class="stat-label">Admins</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">👤</div>
                <div class="stat-value">@Model.Count(u => !u.IsAdmin)</div>
                <div class="stat-label">Regular Users</div>
            </div>
            <div class="stat-card blocked-stat">
                <div class="stat-icon">🚫</div>
                <div class="stat-value">@Model.Count(u => u.IsBlocked)</div>
                <div class="stat-label">Blocked Users</div>
            </div>
        </div>

        <div class="users-table-container">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>👤 User</th>
                        <th>📧 Email</th>
                        <th>🎂 Age</th>
                        <th>🎭 Role</th>
                        <th>📊 Status</th>
                        <th>⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="@(user.IsBlocked ? "blocked-row" : "")">
                            <td>
                                <span class="user-name">@user.FullName</span>
                            </td>
                            <td>
                                <div class="user-email">
                                    @if (user.IsMasterAdmin)
                                    {
                                        <span class="master-crown">👑</span>
                                    }
                                    @user.Email
                                </div>
                            </td>
                            <td>
                                @if (user.Age.HasValue)
                                {
                                    <span class="age-badge">@user.Age.Value</span>
                                }
                                else
                                {
                                    <span style="color: rgba(255,255,255,0.5);">N/A</span>
                                }
                            </td>
                            <td>
                                @if (user.IsMasterAdmin)
                                {
                                    <span class="role-badge badge-master">👑 Master Admin</span>
                                }
                                else if (user.IsAdmin)
                                {
                                    <span class="role-badge badge-admin">⚡ Admin</span>
                                }
                                else
                                {
                                    <span class="role-badge badge-user">👤 User</span>
                                }
                            </td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="role-badge badge-blocked">🚫 Blocked</span>
                                    @if (user.BlockedAt.HasValue)
                                    {
                                        <div class="blocked-info">
                                            Blocked on @user.BlockedAt.Value.ToString("dd MMM yyyy")
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="role-badge badge-active">✅ Active</span>
                                }
                            </td>
                            <td>
                                @if (user.IsMasterAdmin)
                                {
                                    <span class="role-badge badge-protected">🛡️ Protected</span>
                                }
                                else if (isMasterAdmin)
                                {
                                    <div class="action-buttons">
                                        @* ROLE MANAGEMENT *@
                                        @if (!user.IsAdmin)
                                        {
                                            <form asp-action="MakeAdmin" method="post" style="margin: 0;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-promote">
                                                    ⬆️ Promote
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="RemoveAdmin" method="post" style="margin: 0;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-demote">
                                                    ⬇️ Demote
                                                </button>
                                            </form>
                                        }

                                        @* BLOCK/UNBLOCK *@
                                        @if (user.IsBlocked)
                                        {
                                            <form asp-action="UnblockUser" method="post" style="margin: 0;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-unblock">
                                                    ✅ Unblock
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="BlockUser" method="post" style="margin: 0;"
                                                  onsubmit="return confirm('Are you sure you want to block @user.Email?');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="reason" value="Blocked by administrator" />
                                                <button type="submit" class="btn-action btn-block">
                                                    🚫 Block
                                                </button>
                                            </form>
                                        }

                                        @* DELETE *@
                                        <form asp-action="DeleteUser" method="post" style="margin: 0;"
                                              onsubmit="return confirm('Are you sure you want to DELETE @user.Email? This action cannot be undone!');">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn-action btn-delete">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="btn-action btn-disabled">🔒 No Access</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="back-section">
            <a asp-action="Dashboard" class="btn-back">
                ← Back to Dashboard
            </a>
        </div>

    </div>
</div>
