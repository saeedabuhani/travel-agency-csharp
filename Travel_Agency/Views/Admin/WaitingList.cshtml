@using Travel_Agency.Models
@model List<WaitingList>

@{
    ViewData["Title"] = "Waiting List Management";
    var packages = ViewBag.Packages as List<TravelPackage>;
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       📋 WAITING LIST HERO HEADER
       ============================================ */
    .waitlist-hero {
        position: relative;
        min-height: 320px;
        background: url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .waitlist-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.8) 0%, rgba(15, 23, 42, 0.95) 100%);
        z-index: 1;
    }

    .waitlist-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .waitlist-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .waitlist-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 MAIN CONTENT
       ============================================ */
    .waitlist-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 320px);
    }

    .waitlist-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ============================================
       🔔 ALERTS
       ============================================ */
    .alert-custom {
        padding: 18px 25px;
        border-radius: 15px;
        margin-bottom: 30px;
        font-family: 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-success-custom {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
    }

    .alert-error-custom {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }

    /* ============================================
       📊 STATS CARDS
       ============================================ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: rgba(245, 158, 11, 0.3);
    }

    .stat-card .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .stat-card .stat-value {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #fbbf24;
    }

    .stat-card .stat-label {
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ============================================
       📦 PACKAGE SECTIONS
       ============================================ */
    .package-section {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        margin-bottom: 30px;
        overflow: hidden;
    }

    .package-header {
        background: rgba(245, 158, 11, 0.1);
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    }

    .package-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .package-image {
        width: 80px;
        height: 80px;
        border-radius: 15px;
        object-fit: cover;
        border: 2px solid rgba(245, 158, 11, 0.3);
    }

    .package-details h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        color: #fff;
        margin-bottom: 5px;
    }

    .package-details p {
        font-family: 'Poppins', sans-serif;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
    }

    .package-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .meta-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 10px 15px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .meta-badge span {
        color: #fbbf24;
        font-weight: 600;
    }

    .btn-notify-all {
        padding: 12px 25px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-notify-all:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }

    .btn-notify-all:disabled {
        background: rgba(107, 114, 128, 0.3);
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* ============================================
       📋 WAITING LIST TABLE
       ============================================ */
    .waitlist-table-container {
        padding: 25px 30px;
    }

    .waitlist-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .waitlist-table thead th {
        font-family: 'Poppins', sans-serif;
        color: #fbbf24;
        padding: 15px 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.8rem;
        font-weight: 600;
        border: none;
        text-align: left;
    }

    .waitlist-table tbody tr {
        background: rgba(255, 255, 255, 0.02);
        transition: all 0.3s ease;
    }

    .waitlist-table tbody tr:hover {
        background: rgba(245, 158, 11, 0.1);
    }

    .waitlist-table tbody tr.notified-row {
        background: rgba(16, 185, 129, 0.1);
        border-left: 4px solid #10b981;
    }

    .waitlist-table tbody td {
        font-family: 'Poppins', sans-serif;
        padding: 18px 20px;
        border: none;
        color: rgba(255, 255, 255, 0.9);
        vertical-align: middle;
    }

    .waitlist-table tbody td:first-child {
        border-radius: 10px 0 0 10px;
    }

    .waitlist-table tbody td:last-child {
        border-radius: 0 10px 10px 0;
    }

    .position-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        border-radius: 50%;
        font-weight: 700;
        font-size: 1rem;
    }

    .user-info {
        display: flex;
        flex-direction: column;
    }

    .user-name {
        font-weight: 600;
        color: #fff;
    }

    .user-email {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .status-badge {
        display: inline-block;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .status-waiting {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .status-notified {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .date-info {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .btn-remove {
        padding: 8px 15px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-remove:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(239, 68, 68, 0.4);
    }

    /* ============================================
       🚫 EMPTY STATE
       ============================================ */
    .empty-state {
        text-align: center;
        padding: 80px 30px;
    }

    .empty-state .empty-icon {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: #fff;
        margin-bottom: 10px;
    }

    .empty-state p {
        font-family: 'Poppins', sans-serif;
        color: rgba(255, 255, 255, 0.6);
    }

    /* ============================================
       🔙 BACK BUTTON
       ============================================ */
    .back-section {
        text-align: center;
        margin-top: 50px;
    }

    .btn-back {
        padding: 15px 40px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 25px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(245, 158, 11, 0.4);
    }

    .btn-back:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(245, 158, 11, 0.5);
        color: #fff;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .waitlist-title {
            font-size: 2.2rem;
        }

        .package-header {
            flex-direction: column;
            text-align: center;
        }

        .package-info {
            flex-direction: column;
        }

        .waitlist-table-container {
            padding: 15px;
            overflow-x: auto;
        }
    }
</style>

<!-- 📋 WAITING LIST HERO HEADER -->
<div class="waitlist-hero">
    <div class="waitlist-hero-content">
        <h1 class="waitlist-title">⏳ Waiting List</h1>
        <p class="waitlist-subtitle">Manage Users Waiting for Packages</p>
    </div>
</div>

<!-- 📋 MAIN CONTENT -->
<div class="waitlist-content">
    <div class="waitlist-container">

        @if (TempData["Success"] != null)
        {
            <div class="alert-custom alert-success-custom">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-custom alert-error-custom">
                @TempData["Error"]
            </div>
        }

        <!-- 📊 STATS -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-value">@(ViewBag.TotalActive ?? Model.Count)</div>
                <div class="stat-label">Total Active in Queue</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">⏳</div>
                <div class="stat-value">@(ViewBag.TotalWaiting ?? Model.Count(w => w.Status == WaitingListStatus.Waiting))</div>
                <div class="stat-label">Waiting for Rooms</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🔔</div>
                <div class="stat-value">@(ViewBag.TotalNotified ?? Model.Count(w => w.Status == WaitingListStatus.Notified))</div>
                <div class="stat-label">Notified (Pending)</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📦</div>
                <div class="stat-value">@(packages?.Count ?? 0)</div>
                <div class="stat-label">Packages with Waitlist</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <h3>No Waiting List Entries</h3>
                <p>No users are currently waiting for any packages.</p>
            </div>
        }
        else
        {
            @* Group by Package *@
            @foreach (var packageGroup in Model.GroupBy(w => w.TravelPackageId))
            {
                var package = packageGroup.First().TravelPackage;
                var waitingUsers = packageGroup.OrderBy(w => w.Position).ToList();
                
                <div class="package-section">
                    <div class="package-header">
                        <div class="package-info">
                            @if (!string.IsNullOrEmpty(package?.ImageUrl))
                            {
                                <img src="@package.ImageUrl" alt="@package?.Destination" class="package-image" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80" alt="@package?.Destination" class="package-image" />
                            }
                            <div class="package-details">
                                <h3>📍 @package?.Destination, @package?.Country</h3>
                                <p>@package?.PackageType • @package?.Nights nights</p>
                            </div>
                        </div>
                        <div class="package-meta">
                            <div class="meta-badge">
                                🚪 Available Rooms: <span>@package?.AvailableRooms</span>
                            </div>
                            <div class="meta-badge">
                                👥 Waiting: <span>@waitingUsers.Count</span>
                            </div>
                            <form asp-action="NotifyWaitingUsers" method="post" style="margin: 0;">
                                <input type="hidden" name="packageId" value="@package?.Id" />
                                <button type="submit" class="btn-notify-all" 
                                        @(package?.AvailableRooms <= 0 ? "disabled" : "")>
                                    📧 Notify Waiting Users
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="waitlist-table-container">
                        <table class="waitlist-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>👤 User</th>
                                    <th>📅 Joined</th>
                                    <th>📊 Status</th>
                                    <th>⚙️ Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in waitingUsers)
                                {
                                    <tr class="@(entry.Notified ? "notified-row" : "")">
                                        <td>
                                            <span class="position-badge">@entry.Position</span>
                                        </td>
                                        <td>
                                            <div class="user-info">
                                                <span class="user-name">@entry.User?.FullName</span>
                                                <span class="user-email">@entry.User?.Email</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-info">
                                                @entry.JoinedAt.ToString("dd MMM yyyy")
                                                <br />
                                                <small>@entry.JoinedAt.ToString("HH:mm")</small>
                                            </div>
                                        </td>
                                        <td>
                                            @switch (entry.Status)
                                            {
                                                case WaitingListStatus.Waiting:
                                                    <span class="status-badge status-waiting">⏳ In Queue</span>
                                                    break;
                                                case WaitingListStatus.Notified:
                                                    <span class="status-badge status-notified">🔔 Notified</span>
                                                    @if (entry.ExpiresAt.HasValue)
                                                    {
                                                        <div class="date-info" style="margin-top: 5px;">
                                                            ⏰ Expires: @entry.ExpiresAt.Value.ToString("dd MMM HH:mm")
                                                        </div>
                                                        @if (entry.TimeRemaining.HasValue && entry.TimeRemaining.Value.TotalHours > 0)
                                                        {
                                                            <div class="date-info" style="color: #fbbf24;">
                                                                @entry.TimeRemainingDisplay
                                                            </div>
                                                        }
                                                    }
                                                    break;
                                                case WaitingListStatus.Booked:
                                                    <span class="status-badge" style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.3);">✅ Booked</span>
                                                    break;
                                                case WaitingListStatus.Declined:
                                                    <span class="status-badge" style="background: rgba(107, 114, 128, 0.2); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3);">❌ Declined</span>
                                                    break;
                                                case WaitingListStatus.Expired:
                                                    <span class="status-badge" style="background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3);">⏰ Expired</span>
                                                    break;
                                                case WaitingListStatus.Cancelled:
                                                    <span class="status-badge" style="background: rgba(107, 114, 128, 0.2); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3);">🚫 Cancelled</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="RemoveFromWaitingList" method="post" style="margin: 0;"
                                                  onsubmit="return confirm('Remove @entry.User?.Email from waiting list?');">
                                                <input type="hidden" name="waitingListId" value="@entry.Id" />
                                                <button type="submit" class="btn-remove">
                                                    🗑️ Remove
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        <div class="back-section">
            <a asp-action="Dashboard" class="btn-back">
                ← Back to Dashboard
            </a>
        </div>

    </div>
</div>
