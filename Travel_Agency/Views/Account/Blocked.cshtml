@{
    ViewData["Title"] = "Account Blocked";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .blocked-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, #0f172a 100%);
        padding: 20px;
    }

    .blocked-container {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 30px;
        padding: 60px 50px;
        max-width: 550px;
        width: 100%;
        text-align: center;
        box-shadow: 0 25px 80px rgba(239, 68, 68, 0.2);
    }

    .blocked-icon {
        font-size: 6rem;
        margin-bottom: 30px;
        display: block;
        animation: shake 2s ease-in-out infinite;
    }

    @@keyframes shake {
        0%, 100% { transform: rotate(0deg); }
        10%, 30%, 50%, 70%, 90% { transform: rotate(-5deg); }
        20%, 40%, 60%, 80% { transform: rotate(5deg); }
    }

    .blocked-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 700;
        color: #fca5a5;
        margin-bottom: 20px;
    }

    .blocked-message {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.8;
        margin-bottom: 30px;
    }

    .blocked-info {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .blocked-info p {
        font-family: 'Poppins', sans-serif;
        color: rgba(255, 255, 255, 0.7);
        margin: 0;
        font-size: 0.95rem;
    }

    .blocked-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-home {
        padding: 15px 35px;
        background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 25px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-home:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(107, 114, 128, 0.4);
        color: #fff;
    }

    .btn-contact {
        padding: 15px 35px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        border-radius: 25px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-contact:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4);
        color: #fff;
    }

    .support-email {
        font-family: 'Poppins', sans-serif;
        color: #93c5fd;
        margin-top: 30px;
        font-size: 0.9rem;
    }

    .support-email a {
        color: #60a5fa;
        text-decoration: none;
    }

    .support-email a:hover {
        text-decoration: underline;
    }
</style>

<div class="blocked-page">
    <div class="blocked-container">
        <span class="blocked-icon">🚫</span>
        
        <h1 class="blocked-title">Account Blocked</h1>
        
        <p class="blocked-message">
            Your account has been suspended by an administrator. 
            You are unable to access the Travel Agency services at this time.
        </p>
        
        <div class="blocked-info">
            <p>
                If you believe this is a mistake or would like to appeal this decision, 
                please contact our support team for assistance.
            </p>
        </div>
        
        <div class="blocked-actions">
            <a href="/" class="btn-home">
                🏠 Go Home
            </a>
            <a href="mailto:support@travelagency.com" class="btn-contact">
                📧 Contact Support
            </a>
        </div>
        
        <p class="support-email">
            Need help? Email us at <a href="mailto:support@travelagency.com">support@travelagency.com</a>
        </p>
    </div>
</div>
