@model Travel_Agency.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel Agency</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            overflow-x: hidden;
        }

        .register-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-container {
            display: flex;
            width: 100%;
            max-width: 1100px;
            min-height: 700px;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
        }

        /* LEFT SIDE - FORM SECTION (reversed for Sign Up) */
        .form-section {
            flex: 1;
            background: linear-gradient(135deg, #0d4d4d 0%, #1a6b6b 50%, #0f5656 100%);
            padding: 50px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            text-align: center;
            margin-bottom: 30px;
            position: relative;
            letter-spacing: 3px;
        }

        .brand-title::before,
        .brand-title::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 12px;
            height: 2px;
            background: #fff;
        }

        .brand-title::before {
            left: 10%;
            transform: translateX(-50%);
        }

        .brand-title::after {
            right: 10%;
            transform: translateX(50%);
        }

        .social-login {
            display: flex;
            justify-content: center;
            gap: 18px;
            margin-bottom: 20px;
        }

        .social-login a {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #7dd3d3;
            font-size: 18px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-login a:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #7dd3d3;
            transform: scale(1.1);
        }

        .divider-text {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.8rem;
            margin-bottom: 25px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 0;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        @@media (max-width: 1200px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 18px 14px 45px;
            font-size: 13px;
            background: rgba(255, 255, 255, 0.05);
            border: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 0;
            color: #fff;
            transition: all 0.3s ease;
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-control-custom:focus {
            outline: none;
            border-bottom-color: #7dd3d3;
            box-shadow: none;
            background: rgba(255, 255, 255, 0.08);
        }

        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.5);
            font-size: 16px;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: color 0.3s ease;
            font-size: 14px;
        }

        .password-toggle:hover {
            color: #7dd3d3;
        }

        .btn-register {
            width: 100%;
            padding: 15px;
            font-size: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            border: none;
            border-radius: 30px;
            background: #fff;
            color: #0d4d4d;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
            margin-top: 10px;
        }

        .btn-register:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
            background: #f0f0f0;
        }

        .login-link {
            text-align: center;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .login-link p {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

        .login-link a {
            color: #7dd3d3;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .login-link a:hover {
            color: #fff;
        }

        .alert-custom {
            padding: 12px 18px;
            border-radius: 10px;
            margin-bottom: 20px;
            background: rgba(255, 107, 107, 0.1);
            border: 1px solid rgba(255, 107, 107, 0.3);
            color: #ff6b6b;
            font-size: 0.85rem;
        }

        /* RIGHT SIDE - IMAGE SECTION */
        .image-section {
            flex: 1.2;
            position: relative;
            background: url('https://images.unsplash.com/photo-1530789253388-582c481c54b0?ixlib=rb-4.0.3&auto=format&fit=crop&w=1470&q=80') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
        }

        .image-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, rgba(13, 77, 77, 0.3) 0%, rgba(15, 86, 86, 0.6) 100%);
            z-index: 1;
        }

        .image-section > * {
            position: relative;
            z-index: 2;
        }

        .quote-section {
            text-align: center;
            margin-top: 80px;
        }

        .quote-text {
            font-family: 'Playfair Display', serif;
            font-size: 2.3rem;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
            letter-spacing: 1px;
        }

        .social-icons-right {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: auto;
        }

        .social-icons-right a {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 18px;
            transition: all 0.3s ease;
        }

        .social-icons-right .facebook {
            background: #3b5998;
            color: #fff;
        }

        .social-icons-right .twitter {
            background: #1da1f2;
            color: #fff;
        }

        .social-icons-right .instagram {
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            color: #fff;
        }

        .social-icons-right a:hover {
            transform: translateY(-5px) scale(1.1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .back-home {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 10;
        }

        .back-home a {
            color: #fff;
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .back-home a:hover {
            opacity: 1;
        }

        .text-danger {
            font-size: 0.75rem;
            display: block;
            margin-top: 5px;
        }

        /* RESPONSIVE */
        @@media (max-width: 992px) {
            .register-container {
                flex-direction: column-reverse;
                max-width: 550px;
            }

            .image-section {
                min-height: 250px;
            }

            .quote-text {
                font-size: 1.6rem;
            }

            .form-section {
                padding: 35px 30px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }
        }

        @@media (max-width: 576px) {
            .register-wrapper {
                padding: 10px;
            }

            .image-section {
                min-height: 200px;
                padding: 25px;
            }

            .quote-text {
                font-size: 1.3rem;
            }

            .brand-title {
                font-size: 1.6rem;
            }

            .brand-title::before,
            .brand-title::after {
                display: none;
            }

            .form-section {
                padding: 30px 25px;
            }
        }
    </style>
</head>
<body>
    <div class="back-home">
        <a asp-controller="Home" asp-action="Index">
            <i class="fas fa-arrow-left"></i> Back to Home
        </a>
    </div>

    <div class="register-wrapper">
        <div class="register-container">
            <!-- LEFT SIDE - FORM -->
            <div class="form-section">
                <h1 class="brand-title">JOIN US TODAY</h1>

                <div class="social-login">
                    <a href="#" title="Sign up with Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" title="Sign up with Google"><i class="fab fa-google"></i></a>
                    <a href="#" title="Sign up with LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                </div>

                <p class="divider-text">or register with your email</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-custom">
                        <i class="fas fa-exclamation-circle"></i> Please check your information
                        <div asp-validation-summary="All" class="mt-2 small"></div>
                    </div>
                }

                <form method="post" asp-action="Register">
                    <div class="form-row">
                        <div class="form-group">
                            <i class="fas fa-user input-icon"></i>
                            <input asp-for="FullName"
                                   class="form-control-custom"
                                   placeholder="Full Name"
                                   required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <i class="fas fa-envelope input-icon"></i>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control-custom"
                                   placeholder="Email Address"
                                   required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="DateOfBirth"
                                   type="date"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control-custom"
                                   required />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <i class="fas fa-lock input-icon"></i>
                            <input asp-for="Password"
                                   type="password"
                                   id="passwordInput"
                                   class="form-control-custom"
                                   placeholder="Password"
                                   required />
                            <i class="fas fa-eye-slash password-toggle" onclick="togglePassword('passwordInput', this)"></i>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="text-muted">
                                Must be 8+ chars with uppercase, lowercase, number, and one of ! @@ # $ % ^ & *
                            </small>
                        </div>

                        <div class="form-group">
                            <i class="fas fa-shield-alt input-icon"></i>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPasswordInput"
                                   class="form-control-custom"
                                   placeholder="Confirm Password"
                                   required />
                            <i class="fas fa-eye-slash password-toggle" onclick="togglePassword('confirmPasswordInput', this)"></i>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-register">
                        CREATE ACCOUNT
                    </button>
                </form>

                <div class="login-link">
                    <p>Already have an account?</p>
                    <a asp-action="Login">← BACK TO LOGIN</a>
                </div>
            </div>

            <!-- RIGHT SIDE - IMAGE -->
            <div class="image-section">
                <div class="quote-section">
                    <p class="quote-text">
                        ADVENTURE AWAITS<br>
                        YOUR JOURNEY BEGINS<br>
                        HERE
                    </p>
                </div>

                <div class="social-icons-right">
                    <a href="#" class="facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(inputId, toggleElement) {
            const passwordInput = document.getElementById(inputId);
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleElement.classList.remove('fa-eye-slash');
                toggleElement.classList.add('fa-eye');
            } else {
                passwordInput.type = 'password';
                toggleElement.classList.remove('fa-eye');
                toggleElement.classList.add('fa-eye-slash');
            }
        }
    </script>
</body>
</html>
