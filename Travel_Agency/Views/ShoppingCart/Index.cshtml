@model List<Travel_Agency.Models.ShoppingCart>
@using Travel_Agency.Models

@{
    ViewData["Title"] = "Shopping Cart";
    var total = ViewBag.Total ?? 0m;
    var waitingListItems = ViewBag.WaitingListItems as List<WaitingList> ?? new List<WaitingList>();
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       🛒 CART HERO HEADER
       ============================================ */
    .cart-hero {
        position: relative;
        min-height: 280px;
        background: url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .cart-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.75) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .cart-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .cart-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .cart-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 MAIN CONTENT
       ============================================ */
    .cart-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 280px);
    }

    .cart-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ============================================
       🔔 ALERTS
       ============================================ */
    .alert-custom {
        padding: 18px 25px;
        border-radius: 15px;
        margin-bottom: 30px;
        font-family: 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-success-custom {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
    }

    .alert-error-custom {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }

    /* ============================================
       🎴 CART ITEMS
       ============================================ */
    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 40px;
    }

    .cart-item {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 25px;
        display: grid;
        grid-template-columns: 150px 1fr auto auto;
        gap: 25px;
        align-items: center;
        transition: all 0.3s ease;
    }

    .cart-item:hover {
        border-color: rgba(16, 185, 129, 0.5);
        transform: translateX(10px);
    }

    .cart-item-image {
        width: 150px;
        height: 100px;
        border-radius: 15px;
        object-fit: cover;
    }

    .cart-item-info h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        color: #fff;
        margin-bottom: 8px;
    }

    .cart-item-info p {
        font-family: 'Poppins', sans-serif;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        margin: 0;
    }

    .cart-item-price {
        text-align: right;
    }

    .price-original {
        text-decoration: line-through;
        color: #f87171;
        font-size: 0.9rem;
        display: block;
    }

    .price-final {
        font-family: 'Poppins', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #6ee7b7;
    }

    .btn-remove {
        padding: 12px 20px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-remove:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.4);
    }

    /* ============================================
       💰 CART TOTAL
       ============================================ */
    .cart-total-section {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 20px;
        padding: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .cart-total-label {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .cart-total-amount {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        font-weight: 700;
        color: #6ee7b7;
    }

    /* ============================================
       🔘 CART ACTIONS
       ============================================ */
    .cart-actions {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .btn-cart-action {
        padding: 16px 35px;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-continue {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

    .btn-continue:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: #fff;
        color: #fff;
    }

    .btn-checkout {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
    }

    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(16, 185, 129, 0.5);
        color: #fff;
    }

    /* ============================================
       📭 EMPTY STATE
       ============================================ */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-icon {
        font-size: 6rem;
        margin-bottom: 25px;
        opacity: 0.5;
    }

    .empty-text {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 15px;
    }

    .empty-subtext {
        font-family: 'Poppins', sans-serif;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 30px;
    }

    .btn-browse {
        padding: 16px 40px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 30px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
    }

    .btn-browse:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(16, 185, 129, 0.5);
        color: #fff;
    }

    /* ============================================
       ⏳ WAITING LIST SECTION
       ============================================ */
    .waiting-section {
        margin-top: 50px;
        padding-top: 40px;
        border-top: 2px solid rgba(251, 191, 36, 0.3);
    }

    .waiting-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: #fbbf24;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .waiting-item {
        background: rgba(251, 191, 36, 0.08);
        border: 1px solid rgba(251, 191, 36, 0.3);
        border-radius: 20px;
        padding: 25px;
        display: grid;
        grid-template-columns: 150px 1fr auto auto;
        gap: 25px;
        align-items: center;
        margin-bottom: 15px;
        position: relative;
        overflow: hidden;
    }

    .waiting-item::before {
        content: '⏳ WAITING';
        position: absolute;
        top: 10px;
        right: -30px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        padding: 5px 40px;
        font-size: 0.7rem;
        font-weight: 700;
        transform: rotate(45deg);
        letter-spacing: 1px;
    }

    .waiting-item.notified::before {
        content: '🔥 YOUR TURN!';
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .waiting-item.notified {
        border-color: rgba(16, 185, 129, 0.5);
        animation: pulse-glow 2s infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
        50% { box-shadow: 0 0 40px rgba(16, 185, 129, 0.6); }
    }

    .waiting-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        font-family: 'Poppins', sans-serif;
    }

    .badge-position {
        background: rgba(251, 191, 36, 0.2);
        color: #fbbf24;
    }

    .badge-notified {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
    }

    .countdown-timer {
        background: rgba(239, 68, 68, 0.2);
        color: #f87171;
        font-weight: 700;
        font-family: 'Poppins', sans-serif;
        padding: 10px 20px;
        border-radius: 12px;
        font-size: 0.95rem;
    }

    .btn-book-now {
        padding: 12px 25px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-book-now:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
        color: #fff;
    }

    .btn-decline {
        padding: 12px 20px;
        background: rgba(239, 68, 68, 0.2);
        color: #f87171;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-decline:hover {
        background: rgba(239, 68, 68, 0.3);
    }

    .waiting-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .cart-title {
            font-size: 2.2rem;
        }

        .cart-item, .waiting-item {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .cart-item-image {
            width: 100%;
            height: 150px;
        }

        .cart-item-price {
            text-align: center;
        }

        .cart-actions {
            flex-direction: column;
        }

        .btn-cart-action {
            width: 100%;
            justify-content: center;
        }

        .cart-total-section {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .waiting-item::before {
            font-size: 0.6rem;
            padding: 3px 30px;
        }

        .waiting-actions {
            justify-content: center;
        }
    }
</style>

<!-- 🛒 CART HERO HEADER -->
<div class="cart-hero">
    <div class="cart-hero-content">
        <h1 class="cart-title">🛒 Shopping Cart</h1>
        <p class="cart-subtitle">Your Selected Packages</p>
    </div>
</div>

<!-- 📋 MAIN CONTENT -->
<div class="cart-content">
    <div class="cart-container">

        @if (TempData["Success"] != null)
        {
            <div class="alert-custom alert-success-custom">
                ✅ @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-custom alert-error-custom">
                ❌ @TempData["Error"]
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert-custom" style="background: rgba(251, 191, 36, 0.15); border: 1px solid rgba(251, 191, 36, 0.3); color: #fbbf24;">
                ℹ️ @TempData["Info"]
            </div>
        }

        @if (!Model.Any() && !waitingListItems.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">🛒</div>
                <p class="empty-text">Your cart is empty</p>
                <p class="empty-subtext">Add some amazing travel packages to get started!</p>
                <a asp-controller="TravelPackages" asp-action="Index" class="btn-browse">
                    🌍 Browse Packages
                </a>
            </div>
        }
        else if (!Model.Any() && waitingListItems.Any())
        {
            <div style="text-align: center; padding: 40px 20px; margin-bottom: 20px;">
                <div style="font-size: 4rem; margin-bottom: 15px; opacity: 0.7;">🛒</div>
                <p style="font-family: 'Playfair Display', serif; font-size: 1.5rem; color: rgba(255,255,255,0.6);">No packages ready for checkout</p>
                <p style="font-family: 'Poppins', sans-serif; color: rgba(255,255,255,0.4); margin-bottom: 20px;">But you have packages in your waiting list below!</p>
                <a asp-controller="TravelPackages" asp-action="Index" class="btn-browse">
                    🌍 Browse More Packages
                </a>
            </div>
        }
        else
        {
            <div class="cart-items">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        @if (!string.IsNullOrEmpty(item.TravelPackage?.ImageUrl))
                        {
                            <img src="@item.TravelPackage.ImageUrl" alt="@item.TravelPackage.Destination" class="cart-item-image">
                        }
                        else
                        {
                            <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="@item.TravelPackage?.Destination" class="cart-item-image">
                        }

                        <div class="cart-item-info">
                            <h3>@item.TravelPackage?.Destination</h3>
                            <p>📍 @item.TravelPackage?.Country • 🌙 @item.TravelPackage?.Nights nights • 🎯 @item.TravelPackage?.PackageType</p>
                            <p>Added: @item.AddedAt.ToString("dd MMM yyyy")</p>
                        </div>

                        <div class="cart-item-price">
                            @if (item.TravelPackage?.IsDiscountActive == true && item.TravelPackage.Discount.HasValue)
                            {
                                <span class="price-original">$@item.TravelPackage.Price.ToString("N0")</span>
                                <span class="price-final">$@item.TravelPackage.EffectivePrice.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="price-final">$@item.TravelPackage?.Price.ToString("N0")</span>
                            }
                        </div>

                        <form asp-action="RemoveFromCart" method="post" style="margin: 0;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-remove">
                                🗑️ Remove
                            </button>
                        </form>
                    </div>
                }
            </div>

            <div class="cart-total-section">
                <span class="cart-total-label">Total Amount:</span>
                <span class="cart-total-amount">$@total.ToString("N2")</span>
            </div>

            <div class="cart-actions">
                <a asp-controller="TravelPackages" asp-action="Index" class="btn-cart-action btn-continue">
                    ← Continue Shopping
                </a>
                <form asp-action="Checkout" method="post" style="margin: 0;">
                    <button type="submit" class="btn-cart-action btn-checkout">
                        Proceed to Checkout 💳
                    </button>
                </form>
            </div>
        }

        @* ============================================
           ⏳ WAITING LIST SECTION
           ============================================ *@
        @if (waitingListItems.Any())
        {
            <div class="waiting-section">
                <h2 class="waiting-section-title">⏳ Waiting List Packages</h2>
                <p style="color: rgba(255,255,255,0.6); margin-bottom: 25px; font-family: 'Poppins', sans-serif;">
                    These packages have no available rooms yet. You'll be notified when your turn comes!
                </p>

                @foreach (var waiting in waitingListItems)
                {
                    var isNotified = waiting.Status == WaitingListStatus.Notified;
                    var hasExpiry = waiting.ExpiresAt.HasValue && waiting.ExpiresAt > DateTime.Now;

                    <div class="waiting-item @(isNotified ? "notified" : "")">
                        @if (!string.IsNullOrEmpty(waiting.TravelPackage?.ImageUrl))
                        {
                            <img src="@waiting.TravelPackage.ImageUrl" alt="@waiting.TravelPackage.Destination" class="cart-item-image">
                        }
                        else
                        {
                            <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="@waiting.TravelPackage?.Destination" class="cart-item-image">
                        }

                        <div class="cart-item-info">
                            <h3>@waiting.TravelPackage?.Destination</h3>
                            <p>📍 @waiting.TravelPackage?.Country • 🌙 @waiting.TravelPackage?.Nights nights • 🎯 @waiting.TravelPackage?.PackageType</p>
                            <p>Joined: @waiting.JoinedAt.ToString("dd MMM yyyy HH:mm")</p>
                            <div style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
                                <span class="waiting-badge badge-position">🎫 Position #@waiting.Position</span>
                                @if (isNotified)
                                {
                                    <span class="waiting-badge badge-notified">✅ It's your turn!</span>
                                }
                            </div>
                        </div>

                        <div class="cart-item-price">
                            @if (waiting.TravelPackage?.IsDiscountActive == true && waiting.TravelPackage.Discount.HasValue)
                            {
                                <span class="price-original">$@waiting.TravelPackage.Price.ToString("N0")</span>
                                <span class="price-final">$@waiting.TravelPackage.EffectivePrice.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="price-final">$@waiting.TravelPackage?.Price.ToString("N0")</span>
                            }

                            @if (isNotified && hasExpiry)
                            {
                                <div class="countdown-timer" data-expires="@waiting.ExpiresAt?.ToString("o")">
                                    ⏰ <span class="countdown">10:00</span>
                                </div>
                            }
                        </div>

                        <div class="waiting-actions">
                            @if (isNotified && waiting.TravelPackage?.AvailableRooms > 0)
                            {
                                <a asp-controller="TravelPackages" asp-action="Details" asp-route-id="@waiting.TravelPackageId" class="btn-book-now">
                                    🛒 Book Now!
                                </a>
                            }
                            <form asp-action="LeaveWaitingList" method="post" style="margin: 0;">
                                <input type="hidden" name="waitingListId" value="@waiting.Id" />
                                <button type="submit" class="btn-decline" onclick="return confirm('Are you sure you want to leave the waiting list?');">
                                    ❌ Leave List
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@* Countdown Timer Script *@
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const timers = document.querySelectorAll('.countdown-timer');
        
        timers.forEach(timer => {
            const expiresAt = new Date(timer.dataset.expires);
            const countdownEl = timer.querySelector('.countdown');
            
            function updateCountdown() {
                const now = new Date();
                const diff = expiresAt - now;
                
                if (diff <= 0) {
                    countdownEl.textContent = 'EXPIRED!';
                    timer.style.background = 'rgba(239, 68, 68, 0.4)';
                    // Reload page after a short delay to update status
                    setTimeout(() => location.reload(), 2000);
                    return;
                }
                
                const minutes = Math.floor(diff / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                countdownEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                
                // Add urgency colors
                if (minutes < 2) {
                    timer.style.background = 'rgba(239, 68, 68, 0.4)';
                } else if (minutes < 5) {
                    timer.style.background = 'rgba(251, 191, 36, 0.3)';
                }
            }
            
            updateCountdown();
            setInterval(updateCountdown, 1000);
        });
    });
</script>
