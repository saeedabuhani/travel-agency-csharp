@model Travel_Agency.Models.TravelPackage

@{
    ViewData["Title"] = "Edit Travel Package";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       ✏️ EDIT HERO HEADER
       ============================================ */
    .edit-hero {
        position: relative;
        min-height: 280px;
        background: url('@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80")') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .edit-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .edit-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .edit-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .edit-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 FORM CONTENT
       ============================================ */
    .form-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
    }

    .form-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .form-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 25px;
        padding: 40px;
    }

    .form-section {
        margin-bottom: 40px;
    }

    .section-header {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #fbbf24;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-family: 'Poppins', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 10px;
    }

    .form-input, .form-textarea, select.form-input {
        width: 100%;
        padding: 15px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        transition: all 0.3s ease;
    }

    .form-input::placeholder, .form-textarea::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .form-input:focus, .form-textarea:focus, select.form-input:focus {
        outline: none;
        border-color: #fbbf24;
        background: rgba(245, 158, 11, 0.1);
        box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
    }

    select.form-input option {
        background: #0f172a;
        color: #fff;
    }

    .form-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .form-hint {
        font-family: 'Poppins', sans-serif;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
        margin-top: 8px;
    }

    .text-danger {
        color: #fca5a5;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }

    .validation-errors {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
        color: #fca5a5;
        font-family: 'Poppins', sans-serif;
    }

    /* ============================================
       🏨 ADD ROOMS SECTION
       ============================================ */
    .add-rooms-section {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 20px;
        padding: 30px;
        margin-top: 30px;
    }

    .add-rooms-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #93c5fd;
        margin-bottom: 20px;
    }

    .add-rooms-form {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

    .add-rooms-input {
        width: 100px;
        padding: 12px 15px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
    }

    .btn-add-rooms {
        padding: 12px 25px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-add-rooms:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
    }

    .waiting-info {
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 15px;
    }

    /* ============================================
       🔘 BUTTONS
       ============================================ */
    .form-actions {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-form {
        padding: 16px 40px;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-save {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        box-shadow: 0 10px 30px rgba(245, 158, 11, 0.4);
    }

    .btn-save:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(245, 158, 11, 0.5);
    }

    .btn-cancel {
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: rgba(255, 255, 255, 0.7);
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.5);
        color: #fff;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .edit-title {
            font-size: 2.2rem;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-card {
            padding: 25px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-form {
            width: 100%;
            justify-content: center;
        }

        .add-rooms-form {
            flex-direction: column;
            align-items: stretch;
        }

        .add-rooms-input {
            width: 100%;
        }
    }
</style>

<!-- ✏️ EDIT HERO HEADER -->
<div class="edit-hero">
    <div class="edit-hero-content">
        <h1 class="edit-title">✏️ Edit Package</h1>
        <p class="edit-subtitle">@Model.Destination</p>
    </div>
</div>

<!-- 📋 FORM CONTENT -->
<div class="form-content">
    <div class="form-container">

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-card">

                <div asp-validation-summary="All" class="validation-errors"></div>

                <!-- 📍 BASIC INFO -->
                <div class="form-section">
                    <h3 class="section-header">📍 Basic Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Destination</label>
                            <input asp-for="Destination" class="form-input" />
                            <span asp-validation-for="Destination" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Package Type</label>
                            <select asp-for="PackageType" class="form-input">
                                <option value="">-- Select Type --</option>
                                <option>Family</option>
                                <option>Honeymoon</option>
                                <option>Adventure</option>
                                <option>Cruise</option>
                                <option>Luxury</option>
                                <option>Beach</option>
                                <option>Cultural</option>
                                <option>Nature</option>
                                <option>Party</option>
                                <option>Culinary</option>
                                <option>Romantic</option>
                            </select>
                            <span asp-validation-for="PackageType" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Country</label>
                            <input asp-for="Country" class="form-input" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 💰 PRICING -->
                <div class="form-section">
                    <h3 class="section-header">💰 Pricing</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Price (Original)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-input" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Discounted Price</label>
                            <input asp-for="Discount" type="number" step="0.01" class="form-input" />
                            <span asp-validation-for="Discount" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 📅 TRAVEL DATES -->
                <div class="form-section">
                    <h3 class="section-header">📅 Travel Dates</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Start Date</label>
                            <input asp-for="StartDate" type="date" class="form-input" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-input" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Number of Nights</label>
                            <input asp-for="Nights" type="number" min="1" max="60" class="form-input" />
                            <span asp-validation-for="Nights" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Available Rooms</label>
                            <input asp-for="AvailableRooms" type="number" class="form-input" />
                            <span asp-validation-for="AvailableRooms" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 🔥 DISCOUNT PERIOD -->
                <div class="form-section">
                    <h3 class="section-header">🔥 Discount Period (Max 7 Days)</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Discount Start Date</label>
                            <input asp-for="DiscountStartDate" type="date" class="form-input" />
                            <span asp-validation-for="DiscountStartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Discount End Date</label>
                            <input asp-for="DiscountEndDate" type="date" class="form-input" />
                            <span asp-validation-for="DiscountEndDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 📝 DETAILS -->
                <div class="form-section">
                    <h3 class="section-header">📝 Details</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Age Limit</label>
                            <input asp-for="AgeLimit" type="number" class="form-input" />
                            <span asp-validation-for="AgeLimit" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-input" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Visibility</label>
                        <div class="text-muted">Hidden packages are not shown to regular users.</div>
                        <input asp-for="IsVisible" type="checkbox" />
                        <span asp-validation-for="IsVisible" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-textarea"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- 🔘 BUTTONS -->
                <div class="form-actions">
                    <button type="submit" class="btn-form btn-save">
                        ✅ Save Changes
                    </button>
                    <a asp-action="Index" class="btn-form btn-cancel">
                        ← Cancel
                    </a>
                </div>

            </div>
        </form>

        @if (User.IsInRole("Admin"))
        {
            <div class="add-rooms-section">
                <h4 class="add-rooms-title">🏨 Add More Rooms</h4>
                <form asp-action="AddRooms" method="post" class="add-rooms-form">
                    <input type="hidden" name="packageId" value="@Model.Id" />
                    <label class="form-label" style="margin: 0;">Rooms to add:</label>
                    <input type="number" name="roomsToAdd" class="add-rooms-input" min="1" value="1" />
                    <button type="submit" class="btn-add-rooms">➕ Add Rooms</button>
                </form>
                <p class="waiting-info">
                    Current waiting list: @ViewBag.WaitingCount users
                </p>
            </div>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
