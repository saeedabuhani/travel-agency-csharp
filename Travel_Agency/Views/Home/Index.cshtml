<!-- ⭐ TESTIMONIALS SECTION: "What users think about our service" -->
@{
    var websiteReviews = ViewBag.WebsiteReviews as List<Travel_Agency.Models.WebsiteReview> ?? new List<Travel_Agency.Models.WebsiteReview>();
    var averageRating = ViewBag.AverageRating as double? ?? 0.0;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
}

@if (websiteReviews.Any())
{
    <div class="testimonials-section" style="padding: 100px 20px; background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);">
        <div style="max-width: 1200px; margin: 0 auto;">
            <h2 class="section-title">
                What Users Think <span>About Our Service</span>
            </h2>

            @if (averageRating > 0)
            {
                <div style="text-align: center; margin-bottom: 50px;">
                    <div style="font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 700; color: #ffd700; margin-bottom: 10px;">
                        @averageRating.ToString("N1") ⭐
                    </div>
                    <div style="color: rgba(255, 255, 255, 0.8); font-size: 1.1rem;">
                        Based on @totalReviews review@(totalReviews != 1 ? "s" : "")
                    </div>
                </div>
            }

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 40px;">
                @foreach (var review in websiteReviews.Take(6))
                {
                    <div style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 30px; transition: all 0.4s ease;">
                        <div style="display: flex; align-items: center; margin-bottom: 15px;">
                            <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.2rem; margin-right: 15px;">
                                @(review.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #fff; font-size: 1rem;">@(review.User?.FullName ?? "Anonymous")</div>
                                <div style="color: rgba(255, 255, 255, 0.6); font-size: 0.85rem;">@review.CreatedAt.ToString("MMM yyyy")</div>
                            </div>
                        </div>
                        <div style="margin-bottom: 15px;">
                            @for (int i = 0; i < 5; i++)
                            {
                                if (i < review.Rating)
                                {
                                    <span style="color: #ffd700; font-size: 1.2rem;">★</span>
                                }
                                else
                                {
                                    <span style="color: rgba(255, 255, 255, 0.3); font-size: 1.2rem;">☆</span>
                                }
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p style="color: rgba(255, 255, 255, 0.8); line-height: 1.6; font-size: 0.95rem; margin: 0;">
                                "@review.Comment"
                            </p>
                        }
                    </div>
                }
            </div>

            @if (User.Identity!.IsAuthenticated)
            {
                <div style="text-align: center; margin-top: 50px;">
                    <a href="@Url.Action("CreateWebsiteReview", "Reviews")" 
                       style="display: inline-block; padding: 15px 40px; background: linear-gradient(135deg, #ff8c00 0%, #ff6b00 100%); color: white; text-decoration: none; border-radius: 50px; font-weight: 600; transition: all 0.3s ease;">
                        Share Your Experience
                    </a>
                </div>
            }
        </div>
    </div>
}

<!-- 🎯 CTA SECTION -->
<div class="cta-section">
    <h2 class="cta-title">Ready for Your Next Adventure?</h2>
    <p class="cta-subtitle">
        Join thousands of happy travelers who have discovered their dream destinations with us.
    </p>
    <a href="@Url.Action("Index", "TravelPackages")" class="btn-cta">
        Browse All Packages
    </a>
</div>
