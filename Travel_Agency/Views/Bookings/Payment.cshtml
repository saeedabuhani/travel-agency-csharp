@model Travel_Agency.ViewModels.PaymentViewModel
@using Travel_Agency.Models

@{
    ViewData["Title"] = "Payment";
    var booking = ViewBag.Booking as Booking;
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       💳 PAYMENT HERO HEADER
       ============================================ */
    .payment-hero {
        position: relative;
        min-height: 280px;
        background: url('https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .payment-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .payment-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .payment-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .payment-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 MAIN CONTENT
       ============================================ */
    .payment-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 280px);
    }

    .payment-container {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 40px;
    }

    /* ============================================
       📦 BOOKING SUMMARY
       ============================================ */
    .booking-summary {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        overflow: hidden;
        height: fit-content;
        position: sticky;
        top: 120px;
    }

    .booking-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .booking-info {
        padding: 25px;
    }

    .booking-destination {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: #fff;
        margin-bottom: 20px;
    }

    .booking-detail {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-family: 'Poppins', sans-serif;
        font-size: 0.95rem;
    }

    .booking-detail:last-child {
        border-bottom: none;
    }

    .booking-detail-label {
        color: rgba(255, 255, 255, 0.6);
    }

    .booking-detail-value {
        color: #fff;
        font-weight: 600;
    }

    .booking-total {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid rgba(139, 92, 246, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .total-label {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .total-amount {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #a78bfa;
    }

    /* ============================================
       💳 PAYMENT FORM
       ============================================ */
    .payment-form-container {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 35px;
    }

    .form-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ============================================
       🔘 PAYMENT METHOD SELECTOR
       ============================================ */
    .payment-methods {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 30px;
    }

    .payment-method {
        position: relative;
    }

    .payment-method input {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
        z-index: 2;
    }

    .method-card {
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .payment-method input:checked + .method-card {
        border-color: #a78bfa;
        background: rgba(139, 92, 246, 0.15);
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
    }

    .method-card:hover {
        border-color: rgba(139, 92, 246, 0.5);
    }

    .method-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .method-name {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 5px;
    }

    .method-desc {
        font-family: 'Poppins', sans-serif;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .visa-brand {
        background: linear-gradient(135deg, #1a1f71 0%, #00579f 100%);
        padding: 5px 15px;
        border-radius: 5px;
        display: inline-block;
        margin-bottom: 10px;
    }

    .visa-brand span {
        font-family: 'Arial Black', sans-serif;
        font-size: 1.5rem;
        font-style: italic;
        color: #fff;
        letter-spacing: 2px;
    }

    .paypal-brand {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 10px;
    }

    .paypal-brand span {
        font-family: 'Arial', sans-serif;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .paypal-brand .pay {
        color: #003087;
    }

    .paypal-brand .pal {
        color: #009cde;
    }

    /* ============================================
       📝 FORM FIELDS
       ============================================ */
    .payment-fields {
        display: none;
    }

    .payment-fields.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        font-family: 'Poppins', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: #a78bfa;
        margin-bottom: 10px;
    }

    .form-input {
        width: 100%;
        padding: 15px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-input::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .form-input:focus {
        outline: none;
        border-color: #a78bfa;
        background: rgba(139, 92, 246, 0.1);
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .card-icons {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .card-icon {
        padding: 8px 15px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        font-size: 1.5rem;
    }

    /* ============================================
       🔘 BUTTONS
       ============================================ */
    .btn-pay {
        width: 100%;
        padding: 18px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
        margin-top: 10px;
    }

    .btn-pay:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(16, 185, 129, 0.5);
    }

    .btn-pay-paypal {
        background: linear-gradient(135deg, #009cde 0%, #003087 100%);
        box-shadow: 0 10px 30px rgba(0, 156, 222, 0.4);
    }

    .btn-pay-paypal:hover {
        box-shadow: 0 15px 40px rgba(0, 156, 222, 0.5);
    }

    .btn-cancel {
        width: 100%;
        padding: 15px;
        background: transparent;
        color: rgba(255, 255, 255, 0.6);
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 15px;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.4);
        color: #fff;
    }

    .secure-badge {
        text-align: center;
        margin-top: 20px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .text-danger {
        color: #fca5a5;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }

    .security-notice {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 25px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        color: #fbbf24;
    }

    .validation-summary {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 25px;
        color: #fca5a5;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 20px;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .payment-title {
            font-size: 2.2rem;
        }

        .payment-container {
            grid-template-columns: 1fr;
        }

        .booking-summary {
            position: static;
        }

        .payment-methods {
            grid-template-columns: 1fr;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- 💳 PAYMENT HERO HEADER -->
<div class="payment-hero">
    <div class="payment-hero-content">
        <h1 class="payment-title">💳 Complete Payment</h1>
        <p class="payment-subtitle">Secure Checkout</p>
    </div>
</div>

<!-- 📋 MAIN CONTENT -->
<div class="payment-content">
    <div class="payment-container">

        <!-- 📦 BOOKING SUMMARY -->
        @if (booking != null)
        {
            <div class="booking-summary">
                @if (!string.IsNullOrEmpty(booking.Package.ImageUrl))
                {
                    <img src="@booking.Package.ImageUrl" alt="@booking.Package.Destination" class="booking-image">
                }
                else
                {
                    <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="@booking.Package.Destination" class="booking-image">
                }

                <div class="booking-info">
                    <h2 class="booking-destination">@booking.Package.Destination</h2>

                    <div class="booking-detail">
                        <span class="booking-detail-label">📍 Country</span>
                        <span class="booking-detail-value">@booking.Package.Country</span>
                    </div>
                    <div class="booking-detail">
                        <span class="booking-detail-label">🌙 Duration</span>
                        <span class="booking-detail-value">@booking.Package.Nights nights</span>
                    </div>
                    <div class="booking-detail">
                        <span class="booking-detail-label">🎯 Type</span>
                        <span class="booking-detail-value">@booking.Package.PackageType</span>
                    </div>
                    <div class="booking-detail">
                        <span class="booking-detail-label">📅 Travel Date</span>
                        <span class="booking-detail-value">@booking.Package.StartDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="booking-total">
                        <span class="total-label">Total Amount</span>
                        <span class="total-amount">$@(booking.Package.EffectivePrice.ToString("N0"))</span>
                    </div>
                </div>
            </div>
        }

        <!-- 💳 PAYMENT FORM -->
        <div class="payment-form-container">
            <h3 class="form-title">💳 Payment Details</h3>

            <div class="security-notice">
                ⚠️ <strong>Demo Mode:</strong> No real payment is processed. Your information is NOT stored.
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    <strong>Please fix the following errors:</strong>
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Payment" method="post" id="paymentForm">
                <input type="hidden" asp-for="BookingId" />

                <!-- 🔘 PAYMENT METHOD SELECTOR -->
                <div class="payment-methods">
                    <label class="payment-method">
                        <input type="radio" asp-for="PaymentMethod" value="VISA" checked onclick="showPaymentFields('visa')" />
                        <div class="method-card">
                            <div class="visa-brand">
                                <span>VISA</span>
                            </div>
                            <div class="method-name">Credit/Debit Card</div>
                            <div class="method-desc">Pay with VISA, Mastercard, etc.</div>
                        </div>
                    </label>

                    <label class="payment-method">
                        <input type="radio" asp-for="PaymentMethod" value="PayPal" onclick="showPaymentFields('paypal')" />
                        <div class="method-card">
                            <div class="paypal-brand">
                                <span class="pay">Pay</span><span class="pal">Pal</span>
                            </div>
                            <div class="method-name">PayPal</div>
                            <div class="method-desc">Pay with your PayPal account</div>
                        </div>
                    </label>
                </div>

                <!-- 💳 VISA FIELDS -->
                <div id="visaFields" class="payment-fields active">
                    <div class="card-icons">
                        <span class="card-icon">💳</span>
                        <span class="card-icon">🔒</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">👤 Card Holder Name</label>
                        <input asp-for="CardHolder" class="form-input" placeholder="John Doe" />
                        <span asp-validation-for="CardHolder" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">💳 Card Number</label>
                        <input asp-for="CardNumber" class="form-input" placeholder="1234567890123456" 
                               maxlength="16" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        <span asp-validation-for="CardNumber" class="text-danger"></span>
                        <small style="color: rgba(255,255,255,0.4); font-size: 0.75rem;">
                            Enter 16 digits without spaces (e.g., 4532015112830366 for testing)
                        </small>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">📅 Expiry Date</label>
                            <input asp-for="Expiry" class="form-input" placeholder="MM/YY" maxlength="5" 
                                   oninput="formatExpiry(this)" />
                            <span asp-validation-for="Expiry" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">🔐 CVV</label>
                            <input asp-for="CVV" class="form-input" placeholder="123" maxlength="4" 
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            <span asp-validation-for="CVV" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-pay">
                        ✅ Pay with Card
                    </button>
                </div>

                <!-- 📧 PAYPAL FIELDS -->
                <div id="paypalFields" class="payment-fields">
                    <div class="card-icons">
                        <span class="card-icon">📧</span>
                        <span class="card-icon">🔒</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">📧 PayPal Email</label>
                        <input asp-for="PayPalEmail" class="form-input" placeholder="your.email@example.com" type="email" />
                        <span asp-validation-for="PayPalEmail" class="text-danger"></span>
                        <small style="color: rgba(255,255,255,0.4); font-size: 0.75rem;">
                            Enter your PayPal account email address
                        </small>
                    </div>

                    <button type="submit" class="btn-pay btn-pay-paypal">
                        ✅ Pay with PayPal
                    </button>
                </div>

                <a asp-action="MyBookings" class="btn-cancel">
                    ← Cancel
                </a>

                <div class="secure-badge">
                    🔒 Secure payment • 256-bit SSL encryption
                </div>
            </form>
        </div>

    </div>
</div>

<script>
    function showPaymentFields(method) {
        document.getElementById('visaFields').classList.remove('active');
        document.getElementById('paypalFields').classList.remove('active');

        if (method === 'visa') {
            document.getElementById('visaFields').classList.add('active');
        } else {
            document.getElementById('paypalFields').classList.add('active');
        }
    }

    function formatExpiry(input) {
        let value = input.value.replace(/[^0-9]/g, '');
        if (value.length >= 2) {
            value = value.slice(0, 2) + '/' + value.slice(2, 4);
        }
        input.value = value;
    }

    // Initialize on page load based on current selection
    document.addEventListener('DOMContentLoaded', function() {
        var selected = document.querySelector('input[name="PaymentMethod"]:checked');
        if (selected) {
            showPaymentFields(selected.value.toLowerCase());
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
