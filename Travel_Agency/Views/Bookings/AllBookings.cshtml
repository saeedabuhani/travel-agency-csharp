@model IEnumerable<Travel_Agency.Models.Booking>
@using Travel_Agency.Models

@{
    ViewData["Title"] = "All Bookings";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ============================================
       📋 BOOKINGS HERO HEADER
       ============================================ */
    .all-bookings-hero {
        position: relative;
        min-height: 300px;
        background: url('https://images.unsplash.com/photo-1500835556837-99ac94a94552?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .all-bookings-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
        z-index: 1;
    }

    .all-bookings-hero-content {
        position: relative;
        z-index: 2;
        padding: 50px 20px;
    }

    .all-bookings-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
        text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
    }

    .all-bookings-subtitle {
        font-family: 'Poppins', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 2px;
    }

    /* ============================================
       📋 MAIN CONTENT
       ============================================ */
    .all-bookings-content {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98) 0%, #0f172a 100%);
        padding: 60px 20px 100px;
        min-height: calc(100vh - 300px);
    }

    .all-bookings-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ============================================
       📊 BOOKINGS TABLE
       ============================================ */
    .bookings-table-container {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 30px;
        overflow-x: auto;
    }

    .bookings-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .bookings-table thead th {
        font-family: 'Poppins', sans-serif;
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        padding: 18px 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
    }

    .bookings-table thead th:first-child {
        border-radius: 12px 0 0 12px;
    }

    .bookings-table thead th:last-child {
        border-radius: 0 12px 12px 0;
    }

    .bookings-table tbody tr {
        background: rgba(255, 255, 255, 0.02);
        transition: all 0.3s ease;
    }

    .bookings-table tbody tr:hover {
        background: rgba(245, 158, 11, 0.1);
        transform: translateX(5px);
    }

    .bookings-table tbody td {
        font-family: 'Poppins', sans-serif;
        padding: 20px;
        border: none;
        color: rgba(255, 255, 255, 0.9);
        vertical-align: middle;
    }

    .bookings-table tbody td:first-child {
        border-radius: 12px 0 0 12px;
    }

    .bookings-table tbody td:last-child {
        border-radius: 0 12px 12px 0;
    }

    .booking-id {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .user-email {
        color: #93c5fd;
    }

    .destination-name {
        font-weight: 600;
        color: #fff;
    }

    .country-badge {
        display: inline-block;
        padding: 5px 12px;
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
        border-radius: 10px;
        font-size: 0.85rem;
    }

    .price-original {
        text-decoration: line-through;
        color: #f87171;
        font-size: 0.9rem;
    }

    .price-discount {
        color: #6ee7b7;
        font-weight: 700;
        margin-left: 8px;
    }

    .price-normal {
        color: #fff;
        font-weight: 600;
    }

    .booking-date {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-paid {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
    }

    .status-reserved {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
    }

    .status-cancelled {
        background: rgba(107, 114, 128, 0.2);
        color: #9ca3af;
    }

    .btn-cancel {
        padding: 8px 14px;
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.35);
        border-radius: 10px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .btn-cancel:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #fecaca;
    }

    /* ============================================
       🔙 BACK BUTTON
       ============================================ */
    .back-section {
        text-align: center;
        margin-top: 50px;
    }

    .btn-back {
        padding: 15px 40px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        border-radius: 25px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(245, 158, 11, 0.4);
    }

    .btn-back:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(245, 158, 11, 0.5);
        color: #fff;
    }

    /* ============================================
       📱 RESPONSIVE
       ============================================ */
    @@media (max-width: 768px) {
        .all-bookings-title {
            font-size: 2.2rem;
        }

        .bookings-table-container {
            padding: 15px;
        }

        .bookings-table thead {
            display: none;
        }

        .bookings-table tbody tr {
            display: block;
            margin-bottom: 20px;
            border-radius: 15px;
            padding: 15px;
        }

        .bookings-table tbody td {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .bookings-table tbody td::before {
            content: attr(data-label);
            font-weight: 600;
            color: #fbbf24;
        }

        .bookings-table tbody td:first-child,
        .bookings-table tbody td:last-child {
            border-radius: 0;
        }
    }
</style>

<!-- 📋 ALL BOOKINGS HERO HEADER -->
<div class="all-bookings-hero">
    <div class="all-bookings-hero-content">
        <h1 class="all-bookings-title">📋 All Bookings</h1>
        <p class="all-bookings-subtitle">Admin Overview</p>
    </div>
</div>

<!-- 📋 MAIN CONTENT -->
<div class="all-bookings-content">
    <div class="all-bookings-container">

        <div class="bookings-table-container">
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>👤 User</th>
                        <th>✈️ Destination</th>
                        <th>🌍 Country</th>
                        <th>💰 Price</th>
                        <th>📊 Status</th>
                        <th>📅 Booked On</th>
                        <th>⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td data-label="#">
                                <span class="booking-id">#@b.Id</span>
                            </td>
                            <td data-label="User">
                                <span class="user-email">@b.User?.Email</span>
                            </td>
                            <td data-label="Destination">
                                <span class="destination-name">@b.Package.Destination</span>
                            </td>
                            <td data-label="Country">
                                <span class="country-badge">@b.Package.Country</span>
                            </td>
                            <td data-label="Price">
                                @if (b.Package.IsDiscountActive && b.Package.Discount.HasValue)
                                {
                                    <span class="price-original">$@b.Package.Price.ToString("N0")</span>
                                    <span class="price-discount">$@b.Package.EffectivePrice.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="price-normal">$@b.Package.Price.ToString("N0")</span>
                                }
                            </td>
                            <td data-label="Status">
                                <span class="status-badge @(b.Status == BookingStatus.Paid ? "status-paid" : b.Status == BookingStatus.Reserved ? "status-reserved" : "status-cancelled")">
                                    @b.Status
                                </span>
                            </td>
                            <td data-label="Booked On">
                                <span class="booking-date">@b.BookingDate.ToString("dd MMM yyyy HH:mm")</span>
                            </td>
                            <td data-label="Actions">
                                @if (b.Status != BookingStatus.Cancelled)
                                {
                                    <a asp-action="Cancel"
                                       asp-route-id="@b.Id"
                                       class="btn-cancel"
                                       onclick="return confirm('Cancel this booking?');">
                                        ❌ Cancel
                                    </a>
                                }
                                else
                                {
                                    <span class="booking-date">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="back-section">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-back">
                ← Back to Dashboard
            </a>
        </div>

    </div>
</div>
